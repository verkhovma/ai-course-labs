# .env.example
# ШАБЛОН переменных окружения
# СКОПИРУЙТЕ в .env и заполните своими значениями

# GigaChat (альтернатива)
GIGACHAT_AUTHORIZATION_KEY=your_authorization_key_here
# Вы также можете использовать пару Client ID:Client Secret
# Закодируйте пару Client ID:Client Secret в base64 и передавайте ее в GIGACHAT_AUTHORIZATION_KEY
